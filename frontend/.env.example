# Public frontend configuration. VITE_* values are bundled into browser JavaScript.
# Never place private provider secrets in this file.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Demo-only content/payment simulation. Keep false for production.
VITE_ENABLE_DEMO_DATA=false
VITE_DEMO_CHECKOUT_ENABLED=false
