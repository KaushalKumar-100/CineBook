# CineBook backend environment template
# Copy this file to backend/.env for local development.
# NEVER commit backend/.env or real credentials.

APP_NAME=CineBook API
APP_ENV=development
API_PREFIX=/api/v1
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MySQL - local coursework setup
# Your existing database is named cinebook_db.
# Use the MySQL account that you can successfully log in with.
# For local-only development, root is acceptable; for deployment use a
# dedicated least-privilege application account instead.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cinebook_db
DB_USER=root
DB_PASSWORD=
DB_ECHO=false

# Demo mode is for local development only. Set false in production.
DEMO_MODE=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_API_URL=http://127.0.0.1:8000
FRONTEND_RESET_URL=http://localhost:5173/reset-password

# Payments: intentionally disabled until a provider/manual verification workflow is configured.
PAYMENT_ENABLED=false
PAYMENT_PROVIDER=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UPI_PAYMENT_ENABLED=false
UPI_ID=
UPI_DISPLAY_NAME=
UPI_QR_IMAGE_URL=

# Booking inventory
SEAT_HOLD_MINUTES=8
RATE_LIMIT_PER_MINUTE=120
REDIS_URL=

# TMDB movie discovery/import
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Ticketmaster public event discovery (not ticketing/partner inventory access)
TICKETMASTER_API_KEY=
ALLEVENTS_API_KEY=

# Google Maps Platform. Restrict browser keys by HTTP referrer and API.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Browser key belongs in frontend/.env, not backend/.env.
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAPS_MAP_ID=

# Brevo transactional email API
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CineBook
EMAIL_PROVIDER=brevo

# SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Optional AI event-description assistance
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Upload/storage - local disk for development only
UPLOAD_STORAGE_BACKEND=local
UPLOAD_MAX_BYTES=5242880
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=
