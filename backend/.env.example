# Copy to .env and fill in local values. Never commit .env.
APP_NAME=CineBook API
APP_ENV=development
API_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-secret-before-use
ACCESS_TOKEN_EXPIRE_MINUTES=60
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cinebook_db
DB_USER=root
DB_PASSWORD=replace-with-your-local-mysql-password
DB_ECHO=false
DEMO_MODE=true

# Comma-separated exact frontend origins; set the deployed site URL in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
