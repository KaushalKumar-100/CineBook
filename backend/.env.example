# Copy to .env and fill in local values. Never commit .env.
APP_NAME=CineBook API
APP_ENV=development
API_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-secret-before-use
ACCESS_TOKEN_EXPIRE_MINUTES=60
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cinebook_db
DB_USER=root
DB_PASSWORD=replace-with-your-local-mysql-password
DB_ECHO=false
DEMO_MODE=true

# Comma-separated exact frontend origins; set the deployed site URL in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Razorpay secrets are backend-only. Do not add these to the frontend .env.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SEAT_HOLD_MINUTES=8

# TMDB movie discovery/import. Use the API Read Access Token where possible.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Optional event discovery and AI copy assistance.
TICKETMASTER_API_KEY=
ALLEVENTS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional outbound email for password-reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
FRONTEND_RESET_URL=http://localhost:5173/reset-password

# Public API origin used in uploaded poster URLs.
PUBLIC_API_URL=http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=120
